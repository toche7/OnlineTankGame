### Example .env.sample — copy to `.env` and fill values
# PostgreSQL connection string (optional for local development)
DATABASE_URL=postgresql://username:password@localhost:5432/cannon_clash

# Node environment: development or production
NODE_ENV=development

# Optional: override server port (default 3000)
PORT=3000

# Session secret — MUST be set in production
SESSION_SECRET=replace-with-a-long-random-string

# OAuth (optional) — Google OAuth credentials if using login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
